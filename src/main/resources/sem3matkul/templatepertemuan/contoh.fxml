<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sem3matkul.templatepertemuan.controller.ContohController"
      styleClass="root" prefWidth="1020.0" prefHeight="680.0">
    <padding>
        <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox HBox.hgrow="ALWAYS" spacing="4.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="Template Pertemuan: Modul Contoh" styleClass="title-large"/>
                <Label text="Semester 3" styleClass="badge-tag"/>
                <Label text="Template GUI" styleClass="badge-active"/>
            </HBox>
            <Label text="Contoh implementasi standar arsitektur GUI JavaFX: Model, View (FXML), dan Controller"
                   styleClass="subtitle"/>
        </VBox>
    </HBox>

    <!-- Main Content (Form on Left, Table on Right) -->
    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <!-- Left: Input Form Card -->
        <VBox spacing="14.0" styleClass="card" prefWidth="320.0" minWidth="300.0">
            <Label text="📝 Form Input Contoh" styleClass="title-medium"/>
            <Separator/>

            <VBox spacing="6.0">
                <Label text="ID" styleClass="label-bold"/>
                <TextField fx:id="tfId" promptText="contoh: 1"/>
            </VBox>

            <VBox spacing="6.0">
                <Label text="Nama Item" styleClass="label-bold"/>
                <TextField fx:id="tfNama" promptText="contoh: Komponen A"/>
            </VBox>

            <VBox spacing="6.0">
                <Label text="Kategori" styleClass="label-bold"/>
                <ComboBox fx:id="cbKategori" maxWidth="Infinity" promptText="Pilih Kategori..."/>
            </VBox>

            <VBox spacing="6.0">
                <Label text="Deskripsi" styleClass="label-bold"/>
                <TextArea fx:id="taDeskripsi" promptText="Deskripsi singkat atau catatan..." prefRowCount="3" wrapText="true"/>
            </VBox>

            <Label fx:id="lblStatusMessage" wrapText="true" style="-fx-font-size: 11px;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox spacing="8.0">
                <Button text="➕ Tambah" onAction="#handleTambah"
                        styleClass="btn, btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="🔄 Reset" onAction="#handleResetForm"
                        styleClass="btn, btn-secondary"/>
            </HBox>
        </VBox>

        <!-- Right: Table & Stats Card -->
        <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="📋 Daftar Item Contoh" styleClass="title-medium" HBox.hgrow="ALWAYS"/>
                <Button text="🗑️ Hapus Baris" onAction="#handleHapus" styleClass="btn, btn-danger"/>
            </HBox>

            <!-- Table View -->
            <TableView fx:id="tableContoh" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" minWidth="50.0" prefWidth="70.0"/>
                    <TableColumn fx:id="colNama" text="Nama Item" minWidth="150.0" prefWidth="200.0"/>
                    <TableColumn fx:id="colKategori" text="Kategori" minWidth="120.0" prefWidth="140.0"/>
                    <TableColumn fx:id="colDeskripsi" text="Deskripsi" minWidth="200.0" prefWidth="300.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Summary / Stats Bar -->
            <HBox spacing="20.0" alignment="CENTER_LEFT"
                  style="-fx-background-color: #f8fafc; -fx-padding: 10px 14px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <Label text="Total Item:" styleClass="label-bold"/>
                    <Label fx:id="lblTotalData" text="0" style="-fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                </HBox>
            </HBox>
        </VBox>
    </HBox>

    <!-- Bottom: Notes Section -->
    <VBox spacing="6.0" styleClass="notes-box">
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <Label text="💡 Panduan Template Pertemuan:" styleClass="notes-title"/>
        </HBox>
        <Label text="• Salin folder template ini saat ingin membuat modul praktikum atau tugas pertemuan baru." styleClass="notes-text"/>
        <Label text="• Sesuaikan Model (atribut &amp; business logic), FXML (komponen UI), dan Controller (interaksi event &amp; binding tabel)." styleClass="notes-text"/>
        <Label text="• Daftarkan tombol pembuka modul pada DashboardController jika modul sudah siap diakses dari GUI utama." styleClass="notes-text"/>
    </VBox>
</VBox>
