<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="680.0" prefWidth="1020.0" spacing="16.0" styleClass="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sem3matkul.pertemuan11.controller.SimpleParking">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label styleClass="title-large" text="Pertemuan 11: Sistem Parkir Sederhana" />
                <Label styleClass="badge-tag" text="Semester 3" />
                <Label styleClass="badge-active" text="Swing + JDBC" />
            </HBox>
            <Label styleClass="subtitle" text="Panel JavaFX untuk membuka form Swing dan melihat data yang tersimpan di MariaDB." />
        </VBox>
        <Button onAction="#handleTutupSemuaSwing" styleClass="btn, btn-secondary" text="🧹 Tutup Semua Swing" />
    </HBox>

    <HBox spacing="12.0">
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="meeting-card" HBox.hgrow="ALWAYS">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="title-medium" text="Form User" />
                <Label styleClass="subtitle" text="Praktikum: input ke tabel user" wrapText="true" />
            </VBox>
            <Button minWidth="90.0" onAction="#handleBukaFormUser" styleClass="btn, btn-primary" text="🚀 Buka" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="meeting-card" HBox.hgrow="ALWAYS">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="title-medium" text="Form Member" />
                <Label styleClass="subtitle" text="Praktikum: input ke tabel member" wrapText="true" />
            </VBox>
            <Button minWidth="90.0" onAction="#handleBukaFormMember" styleClass="btn, btn-primary" text="🚀 Buka" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="meeting-card" HBox.hgrow="ALWAYS">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="title-medium" text="Form Transaksi" />
                <Label styleClass="subtitle" text="Praktikum: input ke tabel transaksi" wrapText="true" />
            </VBox>
            <Button minWidth="90.0" onAction="#handleBukaFormTrx" styleClass="btn, btn-primary" text="🚀 Buka" />
        </HBox>
    </HBox>

    <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="title-medium" text="🗄️ Data Tersimpan" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblJumlahAktif" styleClass="badge-tag" text="0 jendela aktif" />
            <Button onAction="#handleMuatUlang" styleClass="btn, btn-secondary" text="🔄 Muat Ulang" />
        </HBox>
        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <Tab text="User">
                <TableView fx:id="tblUser" />
            </Tab>
            <Tab text="Member">
                <TableView fx:id="tblMember" />
            </Tab>
            <Tab text="Transaksi">
                <TableView fx:id="tblTransaksi" />
            </Tab>
        </TabPane>
        <Label fx:id="lblStatusMessage" styleClass="subtitle" text="Memuat data..." wrapText="true" />
    </VBox>
</VBox>
